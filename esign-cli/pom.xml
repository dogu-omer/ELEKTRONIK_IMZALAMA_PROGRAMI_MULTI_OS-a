<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>
  <parent>
    <groupId>io.github.doguomer.esign</groupId>
    <artifactId>esign-parent</artifactId>
    <version>0.2.0</version>
  </parent>
  <artifactId>esign-cli</artifactId>
  <description>Komut satırı arayüzü</description>
  <dependencies>
    <dependency>
      <groupId>io.github.doguomer.esign</groupId>
      <artifactId>esign-core</artifactId>
    </dependency>
    <dependency>
      <groupId>io.github.doguomer.esign</groupId>
      <artifactId>esign-token-pkcs11</artifactId>
    </dependency>
    <dependency>
      <groupId>io.github.doguomer.esign</groupId>
      <artifactId>esign-cades</artifactId>
    </dependency>
    <dependency>
      <groupId>io.github.doguomer.esign</groupId>
      <artifactId>esign-dss-support</artifactId>
    </dependency>
    <dependency>
      <groupId>io.github.doguomer.esign</groupId>
      <artifactId>esign-pades</artifactId>
    </dependency>
    <dependency>
      <groupId>io.github.doguomer.esign</groupId>
      <artifactId>esign-xades</artifactId>
    </dependency>
    <dependency>
      <groupId>org.slf4j</groupId>
      <artifactId>slf4j-nop</artifactId>
      <version>2.0.20</version>
      <scope>runtime</scope>
    </dependency>
  </dependencies>
  <build>
    <plugins>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-shade-plugin</artifactId>
        <executions>
          <execution>
            <phase>package</phase>
            <goals><goal>shade</goal></goals>
            <configuration>
              <finalName>esign</finalName>
              <createDependencyReducedPom>false</createDependencyReducedPom>
              <filters>
                <filter>
                  <artifact>*:*</artifact>
                  <excludes>
                    <exclude>META-INF/*.SF</exclude>
                    <exclude>META-INF/*.DSA</exclude>
                    <exclude>META-INF/*.RSA</exclude>
                  </excludes>
                </filter>
              </filters>
              <transformers>
                <transformer implementation="org.apache.maven.plugins.shade.resource.ServicesResourceTransformer"/>
                <transformer implementation="org.apache.maven.plugins.shade.resource.ManifestResourceTransformer">
                  <mainClass>io.github.doguomer.esign.cli.Main</mainClass>
                  <manifestEntries>
                    <Implementation-Version>${project.version}</Implementation-Version>
                    <Implementation-Title>esign</Implementation-Title>
                  </manifestEntries>
                </transformer>
              </transformers>
            </configuration>
          </execution>
        </executions>
      </plugin>
    </plugins>
  </build>
</project>
