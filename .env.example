# Kopyalayıp .env yapın; .env git'e girmez. PIN'i buraya YAZMAYIN.
# Copy to .env (git-ignored). Never put your card PIN here.

# --- CLI / masaüstü / desktop ---
ESIGN_PKCS11_LIB=/usr/lib/libakisp11.so
# İsteğe bağlı RFC 3161 zaman damgası sunucusu (boşsa BES). Kullanıcı adı/şifre URL'ye yazılmaz.
# Optional RFC 3161 TSA (empty = BES). Never put credentials in the URL.
ESIGN_TSA_URL=

# --- REST API (docker compose) ---
# ZORUNLU: anahtar yoksa API başlamaz (fail-closed). En az 24 karakter. Üretin: openssl rand -base64 32
# REQUIRED (min 24 chars). Generate with: openssl rand -base64 32
ESIGN_API_KEY=
# Daha güvenli: sunucuya anahtarın kendisi yerine yalnızca SHA-256 özetini verin (virgülle birden çok = rotasyon).
#   printf '%s' "$ANAHTAR" | sha256sum | cut -d' ' -f1
ESIGN_API_KEY_SHA256=
# IP başına dakikalık /api/** istek sınırı (aşılınca 429)
ESIGN_RATE_LIMIT=120
# Üretimde Swagger UI / OpenAPI belgesini kapatmak için false
ESIGN_API_DOCS=true
# Yalnızca yerel geliştirme: anahtarsız çalıştır (ÜRETİMDE KULLANMAYIN)
# ESIGN_ALLOW_ANONYMOUS=true
ESIGN_PORT=8080
# Güvenilir kök sertifikalar (Kamu SM vb.) bu klasöre konur ve kapsayıcıda /trust olarak görünür.
ESIGN_TRUST_HOST_DIR=./trust
# Kökleri kullanmak için: ESIGN_TRUST_DIR_IN_CONTAINER=/trust
ESIGN_TRUST_DIR_IN_CONTAINER=
ESIGN_OFFLINE=false
ESIGN_SESSION_TTL=10m
ESIGN_MAX_SESSIONS=200
