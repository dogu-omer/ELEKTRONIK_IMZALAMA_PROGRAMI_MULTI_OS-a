#!/bin/sh
# esign postinst: menü kısayolu kurulamazsa (ör. masaüstü olmayan sunucu) kurulum başarısız olmasın.
# Installing the menu entry is best effort; headless systems must still install the package.
set -e
case "$1" in
  configure)
    if command -v xdg-desktop-menu >/dev/null 2>&1; then
      xdg-desktop-menu install /opt/esign/lib/esign-esign-gui.desktop || true
    fi
    ;;
  abort-upgrade|abort-remove|abort-deconfigure) ;;
  *) echo "postinst called with unknown argument \`$1'" >&2; exit 1 ;;
esac
exit 0
